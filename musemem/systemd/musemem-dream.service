[Unit]
Description=musemem: nightly dream and alignment synthesis
After=network-online.target

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/muse-memory/env
Type=oneshot
ExecStart=%h/.local/share/muse-memory/musemem/bin/musemem.py dream
Nice=10
TimeoutStartSec=2h
