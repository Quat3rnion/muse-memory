# Mem0 REST server, built from a pinned upstream commit, with three changes:
#   1. POSTGRES_EMBEDDING_DIMS sets the pgvector dimension (upstream fixes 1536).
#   2. Search calls the reranker (rerank=True). Without a reranker this has no effect.
#   3. The "infinity" reranker provider is registered (infinity_reranker.py).
FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

# Optional: put extra CA certificates (*.crt) in stack/certs/ when your model
# endpoint uses a private TLS authority. httpx and the OpenAI SDK use certifi
# unless SSL_CERT_FILE names the system bundle.
COPY certs/ /usr/local/share/ca-certificates/
RUN update-ca-certificates
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

ARG MEM0_COMMIT=12c47f524935692e27ad48d829f35fa1e4417181
ARG MEM0_VERSION=2.0.17

ADD https://codeload.github.com/mem0ai/mem0/tar.gz/${MEM0_COMMIT} /build/mem0.tar.gz

WORKDIR /app

RUN pip install --no-cache-dir \
    "cryptography==50.0.0" \
    "psycopg[binary]==3.3.4"

RUN mkdir -p /build/mem0-src && \
    tar -xzf /build/mem0.tar.gz --strip-components=1 -C /build/mem0-src && \
    cp -a /build/mem0-src/server/. /app/ && \
    sed -Ei "s/^mem0ai.*$/mem0ai==${MEM0_VERSION}/" requirements.txt && \
    pip install --no-cache-dir -r requirements.txt && \
    groupadd --gid 10001 mem0 && \
    useradd --uid 10001 --gid 10001 --home-dir /app --no-create-home --shell /usr/sbin/nologin mem0 && \
    install -d -o 10001 -g 10001 -m 0700 /app/history && \
    rm -rf /build /root/.cache

RUN sed -i '/"collection_name": POSTGRES_COLLECTION_NAME,/a\            "embedding_model_dims": int(os.environ.get("POSTGRES_EMBEDDING_DIMS", "1536")),' main.py && \
    grep -Fq '"embedding_model_dims": int(os.environ.get("POSTGRES_EMBEDDING_DIMS", "1536"))' main.py

COPY infinity_reranker.py test_infinity_reranker.py /app/
RUN python -m unittest test_infinity_reranker && \
    python -c 'from pathlib import Path; p = Path("main.py"); s = p.read_text(); old = "search(query=search_req.query, filters=filters, **params)"; assert s.count(old) == 1; s = s.replace(old, "search(query=search_req.query, filters=filters, rerank=True, **params)"); p.write_text("import infinity_reranker  # Register the remote provider before state initialization.\n" + s)'

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TMPDIR=/app/history \
    PYTHONPATH=

USER 10001:10001
EXPOSE 8000

CMD ["/bin/sh", "-c", "alembic upgrade head && exec uvicorn main:app --host 0.0.0.0 --port 8000"]
