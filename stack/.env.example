# Copy to .env (chmod 600). Never commit the populated file.
# Generate secrets with: openssl rand -hex 32

# --- Postgres / pgvector -----------------------------------------------------
POSTGRES_HOST=mem0-db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=mem0
POSTGRES_PASSWORD=replace-with-random-database-password
POSTGRES_COLLECTION_NAME=memories
# Must equal the output size of EMBED_MODEL. Do not change it after the first
# start: the vector table keeps its dimension.
POSTGRES_EMBEDDING_DIMS=1024
APP_DB_NAME=mem0_app

# --- Mem0 auth ---------------------------------------------------------------
# ADMIN_API_KEY is also the key the MCP server and musemem send (X-API-Key).
ADMIN_API_KEY=replace-with-random-mem0-api-key
JWT_SECRET=replace-with-random-jwt-secret
AUTH_DISABLED=false
MEM0_TELEMETRY=false
REQUEST_LOG_RETENTION_DAYS=14

# --- Models (any OpenAI-compatible server) -----------------------------------
# Reference setup: a Halogen NPU server serving LFM3-1.7B (fact extraction)
# and qwen3-embedding-0.6b (1024-dim embeddings). Other options, for example:
#   Ollama:    LLM_BASE_URL=http://host.docker.internal:11434/v1
#              LLM_MODEL=qwen3:4b  EMBED_MODEL=qwen3-embedding:0.6b
#   llama.cpp: LLM_BASE_URL=http://host.docker.internal:8080/v1
#   OpenAI:    LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-5-mini
#              EMBED_MODEL=text-embedding-3-small  (POSTGRES_EMBEDDING_DIMS=1536)
LLM_BASE_URL=http://host.docker.internal:8731/v1
LLM_MODEL=LFM3-1.7B
LLM_API_KEY=
# LFM3 reasons by default. Set true + effort "none" to turn reasoning off.
# This mode also stops Mem0 from sending temperature/top_p/max_tokens.
LLM_IS_REASONING_MODEL=true
LLM_REASONING_EFFORT=none

# Empty EMBED_BASE_URL / EMBED_API_KEY reuse the LLM values.
EMBED_BASE_URL=
EMBED_MODEL=qwen3-embedding-0.6b
EMBED_API_KEY=
# Send "dimensions" in embedding requests. Set false if the server rejects it.
EMBED_SEND_DIMENSIONS=true

# --- Optional reranker (Infinity) --------------------------------------------
# Start with: docker compose --profile reranker up -d
# Then set RERANKER_URL=http://reranker:7997/rerank. Empty = no reranking.
RERANKER_URL=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Published ports and dashboard -------------------------------------------
# Ports bind to 127.0.0.1. Change BIND_ADDRESS to expose them on your network.
BIND_ADDRESS=127.0.0.1
MEM0_PORT=9120
DASHBOARD_PORT=3120
# URLs the browser uses. CORS allows only DASHBOARD_URL.
DASHBOARD_URL=http://localhost:3120
DASHBOARD_API_URL=http://localhost:9120
