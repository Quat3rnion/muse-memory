{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "bun"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["panel/**/*.ts", "service/**/*.ts", "shared/**/*.ts", "test/**/*.ts"],
  "exclude": ["**/*.js", "node_modules"]
}
